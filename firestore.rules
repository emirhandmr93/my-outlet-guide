rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /systemConfig/flightPriceRuntime {
      allow read, write: if false;
    }
    function isSignedIn() {
      return request.auth != null;
    }

    function isNonEmptyString(value) {
      return value is string && value.size() > 0;
    }

    function isOptionalStringOrNull(value, maxLength) {
      return value == null || (value is string && value.size() <= maxLength);
    }

    function isValidRating(value) {
      return value is number && value >= 1 && value <= 5;
    }

    function hasValidReviewCategoryRatings(data) {
      return data.categoryRatings is map
        && data.categoryRatings.keys().hasOnly(['transportation', 'brands', 'restaurants', 'services'])
        && data.categoryRatings.keys().hasAll(['transportation', 'brands', 'restaurants', 'services'])
        && isValidRating(data.categoryRatings.transportation)
        && isValidRating(data.categoryRatings.brands)
        && isValidRating(data.categoryRatings.restaurants)
        && isValidRating(data.categoryRatings.services);
    }

    function hasValidReviewContent(data) {
      return isValidRating(data.rating)
        && isValidRating(data.overallRating)
        && hasValidReviewCategoryRatings(data)
        && data.comment is string
        && data.comment.size() <= 4000
        && data.title is string
        && data.title.size() <= 120
        && isNonEmptyString(data.userDisplayName)
        && data.userDisplayName.size() <= 120;
    }

    function hasValidReviewCreateData(outletId, reviewId) {
      return request.resource.data.keys().hasOnly([
          'reviewId',
          'outletId',
          'userId',
          'userDisplayName',
          'rating',
          'overallRating',
          'categoryRatings',
          'title',
          'comment',
          'createdAt',
          'updatedAt',
          'status'
        ])
        && request.resource.data.reviewId == reviewId
        && request.resource.data.reviewId == request.auth.uid
        && request.resource.data.outletId == outletId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'published'
        && hasValidReviewContent(request.resource.data);
    }

    function isDeterministicReviewOwner(outletId, reviewId) {
      return isSignedIn()
        && reviewId == request.auth.uid;
    }

    function keepsReviewRequestOwnership(outletId, reviewId) {
      return request.resource.data.reviewId == reviewId
        && request.resource.data.reviewId == request.auth.uid
        && request.resource.data.outletId == outletId
        && request.resource.data.userId == request.auth.uid;
    }

    function hasValidReviewUpdateData() {
      return request.resource.data.keys().hasOnly([
          'reviewId',
          'outletId',
          'userId',
          'userDisplayName',
          'rating',
          'overallRating',
          'categoryRatings',
          'title',
          'comment',
          'createdAt',
          'updatedAt',
          'status',
          'deletedAt',
          'previousComment',
          'previousTitle',
          'previousRating',
          'previousCategoryRatings',
          'editedAt',
          'editCount'
        ]);
    }

    function hasValidOptionalPreviousCategoryRatings(data) {
      return !('previousCategoryRatings' in data) || (
        data.previousCategoryRatings is map
        && data.previousCategoryRatings.keys().hasOnly(['transportation', 'brands', 'restaurants', 'services'])
        && data.previousCategoryRatings.keys().hasAll(['transportation', 'brands', 'restaurants', 'services'])
        && isValidRating(data.previousCategoryRatings.transportation)
        && isValidRating(data.previousCategoryRatings.brands)
        && isValidRating(data.previousCategoryRatings.restaurants)
        && isValidRating(data.previousCategoryRatings.services)
      );
    }

    function hasValidReviewEditMetadata(data) {
      return (!('previousComment' in data) || (data.previousComment is string && data.previousComment.size() <= 4000))
        && (!('previousTitle' in data) || (data.previousTitle is string && data.previousTitle.size() <= 120))
        && (!('previousRating' in data) || isValidRating(data.previousRating))
        && hasValidOptionalPreviousCategoryRatings(data)
        && (!('editedAt' in data) || data.editedAt is timestamp)
        && (!('editCount' in data) || (data.editCount is number && data.editCount >= 1));
    }

    function isPublishedReviewUpdate() {
      return request.resource.data.status == 'published'
        && !('deletedAt' in request.resource.data)
        && hasValidReviewContent(request.resource.data);
    }

    function isSoftDeleteReviewUpdate() {
      return request.resource.data.status == 'deleted'
        && request.resource.data.deletedAt is string
        && request.resource.data.deletedAt.size() > 0
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedAt.size() > 0;
    }

    function isValidHelpfulCreate(outletId, reviewId, userId) {
      return request.resource.data.keys().hasOnly(['userId', 'createdAt'])
        && userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && exists(/databases/$(database)/documents/reviews/$(outletId)/items/$(reviewId))
        && get(/databases/$(database)/documents/reviews/$(outletId)/items/$(reviewId)).data.userId != request.auth.uid;
    }


    function isOwnerDocument(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function hasValidFavoritesData() {
      return request.resource.data.keys().hasOnly([
          'favoriteIds',
          'favoriteBrandIds',
          'favoriteBrandKeys',
          'savedCampaignIds'
        ])
        && request.resource.data.favoriteIds is list
        && request.resource.data.favoriteIds.size() <= 1000
        && (!request.resource.data.keys().hasAny(['favoriteBrandIds'])
          || (request.resource.data.favoriteBrandIds is list
            && request.resource.data.favoriteBrandIds.size() <= 1000))
        && (!request.resource.data.keys().hasAny(['favoriteBrandKeys'])
          || (request.resource.data.favoriteBrandKeys is list
            && request.resource.data.favoriteBrandKeys.size() <= 1000))
        && (!request.resource.data.keys().hasAny(['savedCampaignIds'])
          || (request.resource.data.savedCampaignIds is list
            && request.resource.data.savedCampaignIds.size() <= 50));
    }

    function hasOnlyValidFlightDealThresholds(thresholds) {
      return thresholds is list
        && thresholds.size() > 0
        && thresholds.hasOnly([15, 30, 45]);
    }

    function hasValidExactDateFlightDealAlertData(userId, alertId) {
      return request.resource.data.keys().hasOnly([
          'schemaVersion',
          'alertId',
          'queryKey',
          'userId',
          'originLabel',
          'originAirportCode',
          'originAirportName',
          'originCityName',
          'originCountryCode',
          'originCountryName',
          'destinationType',
          'destinationKey',
          'destinationAirportCode',
          'destinationAirportName',
          'destinationCityName',
          'destinationCountryCode',
          'destinationCountryName',
          'destinationLabel',
          'tripType',
          'departDate',
          'returnDate',
          'adults',
          'children',
          'infants',
          'tripClass',
          'directOnly',
          'currency',
          'selectedThresholds',
          'active',
          'providerStatus',
          'createdAt',
          'updatedAt'
        ])
        && userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.alertId == alertId
        && request.resource.data.schemaVersion == 2
        && request.resource.data.queryKey == alertId
        && request.resource.data.alertId == request.resource.data.queryKey
        && isNonEmptyString(request.resource.data.originLabel)
        && isNonEmptyString(request.resource.data.originAirportCode)
        && isNonEmptyString(request.resource.data.originAirportName)
        && isNonEmptyString(request.resource.data.originCityName)
        && isNonEmptyString(request.resource.data.originCountryCode)
        && isNonEmptyString(request.resource.data.originCountryName)
        && request.resource.data.destinationType == 'airport'
        && isNonEmptyString(request.resource.data.destinationKey)
        && isNonEmptyString(request.resource.data.destinationAirportCode)
        && isNonEmptyString(request.resource.data.destinationAirportName)
        && isNonEmptyString(request.resource.data.destinationCityName)
        && isNonEmptyString(request.resource.data.destinationCountryCode)
        && isNonEmptyString(request.resource.data.destinationCountryName)
        && isNonEmptyString(request.resource.data.destinationLabel)
        && request.resource.data.originAirportCode.matches('^[A-Z]{3}$')
        && request.resource.data.destinationAirportCode.matches('^[A-Z]{3}$')
        && request.resource.data.originAirportCode != request.resource.data.destinationAirportCode
        && request.resource.data.tripType in ['round_trip', 'one_way']
        && request.resource.data.departDate is string
        && request.resource.data.departDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && ((request.resource.data.tripType == 'round_trip'
            && request.resource.data.keys().hasAll(['returnDate'])
            && request.resource.data.returnDate is string
            && request.resource.data.returnDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && request.resource.data.returnDate >= request.resource.data.departDate)
          || (request.resource.data.tripType == 'one_way'
            && !request.resource.data.keys().hasAny(['returnDate'])))
        && request.resource.data.adults is int
        && request.resource.data.adults >= 1
        && request.resource.data.adults <= 9
        && request.resource.data.children is int
        && request.resource.data.children >= 0
        && request.resource.data.children <= 8
        && request.resource.data.infants is int
        && request.resource.data.infants >= 0
        && request.resource.data.infants <= 9
        && request.resource.data.adults + request.resource.data.children <= 9
        && request.resource.data.infants <= request.resource.data.adults
        && request.resource.data.tripClass in ['economy', 'business']
        && request.resource.data.directOnly is bool
        && request.resource.data.currency == 'EUR'
        && hasOnlyValidFlightDealThresholds(request.resource.data.selectedThresholds)
        && request.resource.data.active is bool
        && request.resource.data.providerStatus == 'pending_provider'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function hasValidUniqueFlightDealThresholds(thresholds) {
      return thresholds == [15] || thresholds == [30] || thresholds == [45]
        || thresholds == [15, 30] || thresholds == [15, 45] || thresholds == [30, 45]
        || thresholds == [15, 30, 45];
    }

    function hasValidRollingRouteFlightDealAlertData(userId, alertId) {
      return request.resource.data.keys().hasOnly([
          'schemaVersion', 'alertId', 'queryKey', 'userId',
          'originLabel', 'originAirportCode', 'originAirportName', 'originCityName', 'originCountryCode', 'originCountryName',
          'destinationType', 'destinationKey', 'destinationAirportCode', 'destinationAirportName',
          'destinationCityName', 'destinationCountryCode', 'destinationCountryName', 'destinationLabel',
          'tripType', 'tripClass', 'directOnly', 'currency', 'monitoringMode', 'monitoringWindowDays',
          'selectedThresholds', 'active', 'providerStatus', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'schemaVersion', 'alertId', 'queryKey', 'userId',
          'originLabel', 'originAirportCode', 'originAirportName', 'originCityName', 'originCountryCode', 'originCountryName',
          'destinationType', 'destinationKey', 'destinationAirportCode', 'destinationAirportName',
          'destinationCityName', 'destinationCountryCode', 'destinationCountryName', 'destinationLabel',
          'tripType', 'tripClass', 'directOnly', 'currency', 'monitoringMode', 'monitoringWindowDays',
          'selectedThresholds', 'active', 'providerStatus', 'createdAt', 'updatedAt'
        ])
        && userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.schemaVersion == 3
        && request.resource.data.alertId == alertId
        && request.resource.data.queryKey == alertId
        && request.resource.data.alertId == request.resource.data.queryKey
        && alertId.matches('^[a-z]{3}_[a-z]{3}_rolling_route_365_(round_trip|one_way)_(economy|business)_(direct|any)_eur$')
        && isNonEmptyString(request.resource.data.originLabel)
        && request.resource.data.originAirportCode is string
        && request.resource.data.originAirportCode.matches('^[A-Z]{3}$')
        && isNonEmptyString(request.resource.data.originAirportName)
        && isNonEmptyString(request.resource.data.originCityName)
        && request.resource.data.originCountryCode is string
        && request.resource.data.originCountryCode.matches('^[A-Z]{2}$')
        && isNonEmptyString(request.resource.data.originCountryName)
        && request.resource.data.destinationType == 'airport'
        && request.resource.data.destinationKey == request.resource.data.destinationAirportCode
        && request.resource.data.destinationAirportCode is string
        && request.resource.data.destinationAirportCode.matches('^[A-Z]{3}$')
        && request.resource.data.originAirportCode != request.resource.data.destinationAirportCode
        && isNonEmptyString(request.resource.data.destinationAirportName)
        && isNonEmptyString(request.resource.data.destinationCityName)
        && request.resource.data.destinationCountryCode is string
        && request.resource.data.destinationCountryCode.matches('^[A-Z]{2}$')
        && isNonEmptyString(request.resource.data.destinationCountryName)
        && isNonEmptyString(request.resource.data.destinationLabel)
        && request.resource.data.tripType in ['round_trip', 'one_way']
        && request.resource.data.tripClass in ['economy', 'business']
        && request.resource.data.directOnly is bool
        && request.resource.data.currency == 'EUR'
        && request.resource.data.monitoringMode == 'rolling_route'
        && request.resource.data.monitoringWindowDays == 365
        && hasValidUniqueFlightDealThresholds(request.resource.data.selectedThresholds)
        && request.resource.data.active is bool
        && request.resource.data.providerStatus == 'pending_provider'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function hasValidFlightDealAlertData(userId, alertId) {
      return hasValidExactDateFlightDealAlertData(userId, alertId)
        || hasValidRollingRouteFlightDealAlertData(userId, alertId);
    }

    function hasValidLegacyFlightDealPreferencesData(userId) {
      return request.resource.data.keys().hasOnly([
          'departureAirportId',
          'selectedCityIds',
          'selectedThresholds'
        ])
        && userId == request.auth.uid
        && isNonEmptyString(request.resource.data.departureAirportId)
        && request.resource.data.selectedCityIds is list
        && request.resource.data.selectedThresholds is list;
    }

    function isAdminOrModerator() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid))
        && get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.role in ['admin', 'moderator'];
    }

    function isPublishedOutletCampaign(campaignId) {
      return resource.data.schemaVersion == 2
        && resource.data.campaignId == campaignId
        && resource.data.status == 'published'
        && resource.data.active == true
        && resource.data.autoPublished == true
        && resource.data.verification is map
        && resource.data.verification.status == 'verified'
        && resource.data.startsAt is timestamp
        && resource.data.endsAt is timestamp
        && resource.data.sourceUrl is string
        && resource.data.sourceUrl.matches('^https://.*$');
    }

    function isValidRootReviewReportCreate(reportId) {
      let outletId = request.resource.data.outletId;
      let reviewId = request.resource.data.reviewId;
      let review = get(/databases/$(database)/documents/reviews/$(outletId)/items/$(reviewId)).data;
      return request.resource.data.keys().hasOnly(['reportId', 'outletId', 'reviewId', 'reporterUserId', 'reviewAuthorUserId', 'reason', 'status', 'createdAt', 'updatedAt'])
        && reportId == outletId + '_' + reviewId + '_' + request.auth.uid
        && request.resource.data.reportId == reportId
        && request.resource.data.reporterUserId == request.auth.uid
        && exists(/databases/$(database)/documents/reviews/$(outletId)/items/$(reviewId))
        && request.resource.data.reviewAuthorUserId == review.userId
        && review.userId != request.auth.uid
        && review.status == 'published'
        && request.resource.data.reason in ['spam', 'offensive', 'misleading', 'other']
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function isValidReviewReportUpdate() {
      return isAdminOrModerator()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'moderationNote', 'moderatedBy', 'moderatedAt'])
        && request.resource.data.status in ['open', 'reviewing', 'dismissed', 'action_taken']
        && request.resource.data.reportId == resource.data.reportId
        && request.resource.data.reporterUserId == resource.data.reporterUserId
        && request.resource.data.reviewId == resource.data.reviewId
        && request.resource.data.outletId == resource.data.outletId
        && request.resource.data.reviewAuthorUserId == resource.data.reviewAuthorUserId
        && request.resource.data.reason == resource.data.reason
        && request.resource.data.createdAt == resource.data.createdAt
        && (!('moderationNote' in request.resource.data) || isOptionalStringOrNull(request.resource.data.moderationNote, 1000))
        && (!('moderatedBy' in request.resource.data) || request.resource.data.moderatedBy == request.auth.uid)
        && (!('moderatedAt' in request.resource.data) || request.resource.data.moderatedAt is timestamp)
        && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is timestamp || request.resource.data.updatedAt is string);
    }

    function isValidModerationActionCreate(actionId) {
      return isAdminOrModerator()
        && request.resource.data.keys().hasOnly(['actionId', 'reportId', 'outletId', 'reviewId', 'moderatorUserId', 'action', 'reason', 'note', 'createdAt'])
        && request.resource.data.actionId == actionId
        && request.resource.data.moderatorUserId == request.auth.uid
        && request.resource.data.reason in ['spam', 'offensive', 'misleading', 'other']
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 1000
        && request.resource.data.createdAt is timestamp
        && request.resource.data.action in ['mark_reviewing', 'dismiss_report', 'hide_review', 'restore_review', 'add_note'];
    }

    function isValidModeratedReviewStatusUpdate() {
      return isAdminOrModerator()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'moderatedBy', 'moderatedAt', 'moderationNote'])
        && request.resource.data.status in ['hidden', 'published']
        && request.resource.data.reviewId == resource.data.reviewId
        && request.resource.data.outletId == resource.data.outletId
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.createdAt == resource.data.createdAt
        && (!('authorDeleted' in request.resource.data) || request.resource.data.authorDeleted == resource.data.authorDeleted)
        && (!('moderationNote' in request.resource.data) || isOptionalStringOrNull(request.resource.data.moderationNote, 1000))
        && request.resource.data.moderatedBy == request.auth.uid
        && request.resource.data.moderatedAt is timestamp
        && (request.resource.data.updatedAt is timestamp || request.resource.data.updatedAt is string);
    }

    function isValidReviewReportCreate(outletId, reviewId, userId) {
      let review = get(/databases/$(database)/documents/reviews/$(outletId)/items/$(reviewId)).data;
      return request.resource.data.keys().hasOnly([
          'reportId',
          'outletId',
          'reviewId',
          'reporterUserId',
          'reviewAuthorUserId',
          'reason',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && userId == request.auth.uid
        && exists(/databases/$(database)/documents/reviews/$(outletId)/items/$(reviewId))
        && !exists(/databases/$(database)/documents/reviews/$(outletId)/items/$(reviewId)/reports/$(userId))
        && request.resource.data.reportId == userId
        && request.resource.data.outletId == outletId
        && request.resource.data.reviewId == reviewId
        && request.resource.data.reporterUserId == request.auth.uid
        && request.resource.data.reviewAuthorUserId == review.userId
        && request.resource.data.reporterUserId != review.userId
        && review.status == 'published'
        && !(review.keys().hasAny(['deletedAt']) && review.deletedAt != null)
        && request.resource.data.reason in ['spam', 'offensive', 'misleading', 'other']
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }


    function hasValidNotificationSettingsData(userId) {
      return request.resource.data.keys().hasOnly([
          'userId',
          'enabled',
          'tripRemindersEnabled',
          'favoriteOutletUpdatesEnabled',
          'favoriteBrandCampaignsEnabled',
          'savedCampaignRemindersEnabled',
          'reviewUpdatesEnabled',
          'marketingEnabled',
          'updatedAt',
          'firestoreUpdatedAt',
          'disabledAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && userId == request.auth.uid
        && request.resource.data.enabled is bool
        && request.resource.data.tripRemindersEnabled is bool
        && request.resource.data.favoriteOutletUpdatesEnabled is bool
        && (!request.resource.data.keys().hasAny(['favoriteBrandCampaignsEnabled'])
          || request.resource.data.favoriteBrandCampaignsEnabled is bool)
        && (!request.resource.data.keys().hasAny(['savedCampaignRemindersEnabled'])
          || request.resource.data.savedCampaignRemindersEnabled is bool)
        && request.resource.data.reviewUpdatesEnabled is bool
        && request.resource.data.marketingEnabled is bool
        && isNonEmptyString(request.resource.data.updatedAt)
        && (request.resource.data.disabledAt == null || isNonEmptyString(request.resource.data.disabledAt));
    }
    function hasValidNotificationTokenData(userId) {
      return request.resource.data.keys().hasOnly([
          'userId',
          'token',
          'platform',
          'createdAt',
          'updatedAt',
          'disabledAt',
          'firestoreCreatedAt',
          'firestoreUpdatedAt',
          'notificationLocale',
          'timeZone'
        ])
        && userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && isNonEmptyString(request.resource.data.token)
        && request.resource.data.token.size() <= 512
        && request.resource.data.platform in ['ios', 'android', 'web', 'windows', 'macos']
        && isNonEmptyString(request.resource.data.createdAt)
        && isNonEmptyString(request.resource.data.updatedAt)
        && (!request.resource.data.keys().hasAny(['notificationLocale'])
          || request.resource.data.notificationLocale in ['en', 'tr', 'es', 'fr', 'de', 'ar', 'ru', 'zh'])
        && (!request.resource.data.keys().hasAny(['timeZone'])
          || (request.resource.data.timeZone is string && request.resource.data.timeZone.size() > 0
            && request.resource.data.timeZone.size() <= 80))
        && (request.resource.data.disabledAt == null || isNonEmptyString(request.resource.data.disabledAt));
    }

    function keepsNotificationTokenOwnership(userId) {
      return userId == request.auth.uid
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.token == resource.data.token
        && request.resource.data.platform == resource.data.platform
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function hasValidTripData(userId, tripId) {
      return request.resource.data.keys().hasOnly([
          'tripId',
          'userId',
          'outletId',
          'outletName',
          'tripName',
          'destination',
          'country',
          'city',
          'visitDate',
          'travelerCount',
          'notes',
          'status',
          'createdAt',
          'updatedAt',
          'firestoreCreatedAt',
          'firestoreUpdatedAt',
          'startDate',
          'endDate',
          'segments',
          'campaignTargetKeys',
          'campaignTargetsUpdatedAt',
          'flightDetails',
          'reminderPlan'
        ])
        && request.resource.data.userId == request.auth.uid
        && userId == request.auth.uid
        && (request.resource.data.tripId == tripId || request.resource.data.tripId == null)
        && isOptionalStringOrNull(request.resource.data.outletId, 160)
        && isOptionalStringOrNull(request.resource.data.outletName, 240)
        && isNonEmptyString(request.resource.data.tripName)
        && request.resource.data.tripName.size() <= 240
        && isOptionalStringOrNull(request.resource.data.destination, 240)
        && isOptionalStringOrNull(request.resource.data.country, 120)
        && isOptionalStringOrNull(request.resource.data.city, 120)
        && isOptionalStringOrNull(request.resource.data.visitDate, 40)
        && (request.resource.data.travelerCount == null || (request.resource.data.travelerCount is number && request.resource.data.travelerCount >= 1 && request.resource.data.travelerCount <= 50))
        && isOptionalStringOrNull(request.resource.data.notes, 2000)
        && request.resource.data.status in ['upcoming', 'active', 'past']
        && isOptionalStringOrNull(request.resource.data.startDate, 40)
        && isOptionalStringOrNull(request.resource.data.endDate, 40)
        && request.resource.data.segments is list
        && (!('campaignTargetKeys' in request.resource.data)
          || (request.resource.data.campaignTargetKeys is list
            && request.resource.data.campaignTargetKeys.size() <= 200))
        && (!('campaignTargetsUpdatedAt' in request.resource.data)
          || request.resource.data.campaignTargetsUpdatedAt is timestamp)
        && (request.resource.data.flightDetails == null || request.resource.data.flightDetails is map)
        && request.resource.data.reminderPlan is list
        && isNonEmptyString(request.resource.data.createdAt)
        && isNonEmptyString(request.resource.data.updatedAt);
    }

    function keepsTripOwnership(userId, tripId) {
      return resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.tripId == resource.data.tripId
        && request.resource.data.tripId == tripId
        && userId == request.auth.uid;
    }

    match /favorites/{userId} {
      allow read: if isOwnerDocument(userId);
      allow create, update: if isOwnerDocument(userId) && hasValidFavoritesData();
      allow delete: if isOwnerDocument(userId);
    }

    match /flightDealPreferences/{userId} {
      allow read: if isOwnerDocument(userId);
      allow create, update: if isSignedIn() && hasValidLegacyFlightDealPreferencesData(userId);
      allow delete: if isOwnerDocument(userId);

      match /alerts/{alertId} {
        allow read: if isOwnerDocument(userId);
        allow create: if isSignedIn() && hasValidFlightDealAlertData(userId, alertId);
        allow update: if isSignedIn() && hasValidFlightDealAlertData(userId, alertId)
          && request.resource.data.schemaVersion == resource.data.schemaVersion
          && (request.resource.data.schemaVersion != 3 || request.resource.data.createdAt == resource.data.createdAt);
        allow delete: if isOwnerDocument(userId);
      }
    }

    match /flightFareRoutes/{routeKey} {
      allow read: if true;
      allow create, update, delete: if false;

      match /dailySnapshots/{yyyyMMdd} {
        allow read: if true;
        allow create, update, delete: if false;
      }

      match /stats/{statId} {
        allow read: if true;
        allow create, update, delete: if false;
      }
    }

    match /outletCampaigns/{campaignId} {
      allow get: if isPublishedOutletCampaign(campaignId)
        && resource.data.startsAt <= request.time
        && resource.data.endsAt > request.time;
      // Firestore rules are not filters. Keep list access aligned with the
      // exact constraints required by the client query; only Admin SDK jobs
      // can write these documents and the client validates the full schema.
      allow list: if resource.data.status == 'published'
        && resource.data.active == true;
      allow create, update, delete: if false;
    }

    match /publicConfig/travelPartners {
      allow read: if true;
      allow create, update, delete: if false;
    }

    match /outletCampaignIngestionRuns/{runId} {
      allow read, write: if false;
    }

    match /systemLocks/{lockId} {
      allow read, write: if false;
    }


    match /adminUsers/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdminOrModerator());
      allow list: if isAdminOrModerator();
      allow create, update, delete: if false;
    }

    match /reviewReports/{reportId} {
      allow get: if isSignedIn() && reportId.matches('.*_' + request.auth.uid);
      allow create: if isSignedIn() && !exists(/databases/$(database)/documents/reviewReports/$(reportId)) && isValidRootReviewReportCreate(reportId);
      allow read: if isSignedIn() && (resource.data.reporterUserId == request.auth.uid || isAdminOrModerator());
      allow update: if false;
      allow delete: if false;
    }

    match /moderationActions/{actionId} {
      allow create: if false;
      allow read: if isAdminOrModerator();
      allow update, delete: if false;
    }

    match /reviews/{outletId}/items/{reviewId} {
      allow read: if true;
      allow create: if isDeterministicReviewOwner(outletId, reviewId)
        && hasValidReviewCreateData(outletId, reviewId);
      allow update: if isDeterministicReviewOwner(outletId, reviewId)
        && keepsReviewRequestOwnership(outletId, reviewId)
        && resource.data.status == 'published'
        && hasValidReviewUpdateData()
        && hasValidReviewEditMetadata(request.resource.data)
        && (isPublishedReviewUpdate() || isSoftDeleteReviewUpdate());
      allow delete: if false;

      match /helpful/{userId} {
        allow read: if true;
        allow create: if isSignedIn() && isValidHelpfulCreate(outletId, reviewId, userId);
        allow delete: if isSignedIn() && userId == request.auth.uid && resource.data.userId == request.auth.uid;
        allow update: if false;
      }

      match /reports/{userId} {
        allow read: if isSignedIn() && userId == request.auth.uid;
        allow create: if isSignedIn() && isValidReviewReportCreate(outletId, reviewId, userId);
        allow update, delete: if false;
      }
    }


    match /userTrips/{userId}/items/{tripId} {
      allow read: if isOwnerDocument(userId);
      allow create: if isSignedIn() && hasValidTripData(userId, tripId);
      allow update: if isSignedIn() && keepsTripOwnership(userId, tripId) && hasValidTripData(userId, tripId);
      allow delete: if isSignedIn() && userId == request.auth.uid && resource.data.userId == request.auth.uid;
    }


    match /userNotificationSettings/{userId} {
      allow read: if isOwnerDocument(userId);
      allow create, update: if isSignedIn() && hasValidNotificationSettingsData(userId);
      allow delete: if isOwnerDocument(userId);

      match /tokens/{tokenId} {
        allow read: if isOwnerDocument(userId);
        allow create: if isSignedIn() && hasValidNotificationTokenData(userId);
        allow update: if isSignedIn()
          && keepsNotificationTokenOwnership(userId)
          && hasValidNotificationTokenData(userId);
        allow delete: if isOwnerDocument(userId);
      }
    }

    match /userFlightPriceDeals/{userId}/items/{eventId} {
      allow get: if isSignedIn()
        && request.auth.uid == userId
        && resource.data.userId == userId
        && resource.data.eventId == eventId;
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /notificationDeliveries/{deliveryId} {
      allow read, write: if false;
    }
  }
}

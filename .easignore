# EAS Build archive size policy:
# Keep runtime application code/config/assets in the upload; exclude only local,
# source-only, generated, or server/tooling files that are not needed by the
# React Native client build.

# Runtime media is intentionally NOT ignored:
# !assets/outlet-images/**

# Client build source-only inputs and project documentation
media-sources/**
docs/**
tools/**
MasterData/**
.github/**
functions/**
web/**
coverage/**
.tmp/**
assets.zip
AGENTS.md
CLAUDE.md
firebase.json
firestore.indexes.json
firestore.rules

# Generated outputs and native folders recreated by EAS Build
.expo/**
dist/**
dist-android/**
dist-ios/**
dist-web-poc/**
web-build/**
android/**
ios/**
src/translations/.generated-web/**
expo-env.d.ts
*.tsbuildinfo

# Local dependencies, secrets, signing material, and repository/editor metadata
node_modules/**
.git/**
.vscode/**
.idea/**
.env*.local
.secret.local
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem

# Local temp files, caches, and logs
.kotlin/**
.metro-health-check*
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.orig.*
*.tmp
*.temp
tmp/**
temp/**
.DS_Store
Thumbs.db
